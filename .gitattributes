# Windows batch files MUST use CRLF: cmd.exe mis-parses LF-only line endings,
# which silently truncates `if (...)` blocks and skips the rest of the script.
*.bat text eol=crlf
*.cmd text eol=crlf
*.vbs text eol=crlf

# Everything else stays LF.
*.py   text eol=lf
*.pyw  text eol=lf
*.mjs  text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

# Extension-less files need an explicit rule, or core.autocrlf rewrites them on
# checkout and they show up as spurious modifications.
LICENSE               text eol=lf
.gitignore            text eol=lf
.gitattributes        text eol=lf
requirements.txt      text eol=lf

# Binary assets
*.png binary
*.ico binary
*.wav binary
*.zip binary
*.wasm binary
